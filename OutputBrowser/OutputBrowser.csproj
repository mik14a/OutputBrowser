<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OutputBrowser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <LangVersion>preview</LangVersion>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION;</DefineConstants>
    <ApplicationIcon>Assets\Tiles\OutputBrowser.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
    <PackageReference Include="System.Interactive" Version="7.0.1" />
    <PackageReference Include="System.Interactive.Async" Version="7.0.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Tiles\OutputBrowser.ico" />
    <Content Include="Assets\Tiles\TitlebarLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Self-contained 2.x does not copy Microsoft.WindowsAppRuntime.Insights.Resource.dll.
    AppNotificationManager.Register() loads it at runtime (0x8007007E).
    https://github.com/microsoft/WindowsAppSDK/issues/6774
    Remove this PropertyGroup and both targets when Microsoft.WindowsAppSDK is newer
    than 2.5.1 and includes https://github.com/microsoft/WindowsAppSDK/pull/6776
    (cherry-pick of https://github.com/microsoft/WindowsAppSDK/pull/6725). That release
    treats a missing DLL as self-contained and Register() no longer throws, so this
    copy is unnecessary. Confirm by deleting it and launching once.
  -->
  <PropertyGroup>
    <WindowsAppRuntimeNativeArch Condition="'$(Platform)' == 'x64' or '$(RuntimeIdentifier)' == 'win-x64'">x64</WindowsAppRuntimeNativeArch>
    <WindowsAppRuntimeNativeArch Condition="'$(Platform)' == 'x86' or '$(Platform)' == 'Win32' or '$(RuntimeIdentifier)' == 'win-x86'">x86</WindowsAppRuntimeNativeArch>
    <WindowsAppRuntimeNativeArch Condition="'$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64' or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</WindowsAppRuntimeNativeArch>
    <WindowsAppRuntimeFrameworkMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-$(WindowsAppRuntimeNativeArch)\Microsoft.WindowsAppRuntime.2.msix</WindowsAppRuntimeFrameworkMsix>
  </PropertyGroup>

  <Target Name="CopyWindowsAppRuntimeInsightsResource"
          AfterTargets="Build"
          Inputs="$(WindowsAppRuntimeFrameworkMsix)"
          Outputs="$(TargetDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' and '$(WindowsAppRuntimeNativeArch)' != '' and Exists('$(WindowsAppRuntimeFrameworkMsix)')">
    <PropertyGroup>
      <WindowsAppRuntimeInsightsResource>$(IntermediateOutputPath)InsightsResource\Microsoft.WindowsAppRuntime.Insights.Resource.dll</WindowsAppRuntimeInsightsResource>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)InsightsResource" />
    <Exec Command="&quot;$(SystemRoot)\System32\tar.exe&quot; -xf &quot;$(WindowsAppRuntimeFrameworkMsix)&quot; -C &quot;$(IntermediateOutputPath)InsightsResource&quot; Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
    <Copy SourceFiles="$(WindowsAppRuntimeInsightsResource)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="AddWindowsAppRuntimeInsightsResourceToPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="Exists('$(TargetDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll">
        <RelativePath>Microsoft.WindowsAppRuntime.Insights.Resource.dll</RelativePath>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
